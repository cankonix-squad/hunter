CANKONIX_PUBLIC_HOST=hunter.cankonix.com
CANKONIX_TRAEFIK_NETWORK=replace-with-existing-external-network
CANKONIX_TRAEFIK_ENTRYPOINT=websecure
CANKONIX_TRAEFIK_CERT_RESOLVER=replace-with-existing-acme-resolver

# Paths only. Keep secret values outside this repository and .env files.
CANKONIX_POSTGRES_PASSWORD_SECRET_FILE=/secure/path/postgres_password
CANKONIX_DATABASE_URL_SECRET_FILE=/secure/path/database_url
CANKONIX_JWT_SECRET_FILE=/secure/path/jwt_secret

# Optional delivery/bootstrap secret paths; leave unset unless enabled intentionally.
CANKONIX_BOOTSTRAP_ADMIN_PASSWORD_SECRET_FILE=
CANKONIX_SMTP_PASSWORD_SECRET_FILE=
CANKONIX_WEBHOOK_SECRET_FILE=
